---
import { Image } from 'astro:assets';
import { following } from '../data/following';
---
<section class="following" aria-labelledby="following-heading">
  <div class="following-heading">
    <h2 id="following-heading"><span aria-hidden="true">✳</span>也看比赛</h2>
    <p>电竞 / 足球 / 网球</p>
  </div>
  <div class="following-grid">
    {following.map((person, index) => <figure data-person={person.id}>
      <div class="portrait-stage">
        <div class="portrait-fade">
          <div class="portrait-cutout" style={person.mask ? `--portrait-mask: url('${person.mask}')` : undefined}>
            <Image src={person.image} alt={person.alt}
              width={person.image.width} height={person.image.height}
              widths={[160, person.image.width]}
              sizes={person.id === 'sinner'
                ? '(max-width: 760px) min(180px, calc((100vw - 76px) * .42)), (max-width: 1100px) 19vw, 240px'
                : '(max-width: 760px) min(144px, calc((100vw - 76px) * .42)), 160px'}
              format="webp" quality={88} loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <figcaption>
        <div class="person-line"><h3>{person.name}</h3><span>{person.sport}</span></div>
        <div class="person-caption"><span>{person.fullName}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
      </figcaption>
    </figure>)}
  </div>
  <details class="photo-credits">
    <summary>图片说明</summary>
    <p>图片由博主选用，本站仅做裁切、转码与显示效果处理。原始摄影来源待补充，图片权利归原权利人所有。</p>
  </details>
</section>

<style>
  .following { --muted: var(--ink); --line: #24251f40; margin-top: 68px; padding: 28px 34px 12px; color: var(--ink); background: var(--orange); }
  .following-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 20px; padding-bottom: 19px; border-bottom: 1px solid var(--line); }
  .following-heading h2 { display: flex; align-items: center; gap: 12px; margin: 0; font: 600 25px/1.5 var(--serif); }
  .following-heading h2 > span { font: 32px/1 Arial, sans-serif; }
  .following-heading p { margin: 0; font-size: 11px; letter-spacing: .1em; }
  .following-grid { display: grid; grid-template-columns: .92fr 1fr 1fr 1.25fr; gap: 24px; }
  figure { margin: 0; min-width: 0; }
  /* Separate masks keep the original skin tones clear, fading only the lower image into orange. */
  .portrait-stage { height: 210px; display: flex; align-items: flex-end; justify-content: center; }
  .portrait-fade { width: 160px; max-width: 100%; -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 62%, #000e 73%, #0005 90%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 62%, #000e 73%, #0005 90%, transparent 100%); }
  .portrait-cutout { -webkit-mask-image: var(--portrait-mask, none); mask-image: var(--portrait-mask, none); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: 100% 100%; mask-size: 100% 100%; }
  .portrait-cutout img { display: block; width: 100%; height: auto; filter: saturate(.85); }
  [data-person="theshy"] .portrait-fade { margin-bottom: 23px; -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 77%, #000c 87%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 77%, #000c 87%, transparent 100%); }
  [data-person="alcaraz"] .portrait-fade { width: 155px; }
  [data-person="sinner"] .portrait-fade { width: 240px; margin-bottom: 18px; -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 81%, #000b 91%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 81%, #000b 91%, transparent 100%); }
  figcaption { padding-top: 9px; }
  .person-line { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .person-line h3 { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.5; }
  .person-line > span { font-size: 10px; }
  .person-caption { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; padding: 9px 0 13px; border-bottom: 1px solid var(--line); font: 9px/1.6 var(--mono); letter-spacing: .05em; }
  .person-caption > span:last-child { font-size: 10px; }
  .photo-credits { margin-top: 5px; font-size: 11px; line-height: 1.9; }
  summary { width: fit-content; min-height: 44px; align-content: center; cursor: pointer; text-underline-offset: 4px; }
  summary:hover { text-decoration: underline; }
  summary:focus-visible { outline-color: var(--ink); }
  .photo-credits p { max-width: 760px; margin: 2px 0 16px; }
  @media (max-width: 1100px) and (min-width: 761px) {
    .following { padding-inline: 26px; }
    .following-grid { gap: 20px; }
    .portrait-stage { height: 186px; }
    .portrait-fade { width: 142px; }
    [data-person="alcaraz"] .portrait-fade { width: 140px; }
    [data-person="sinner"] .portrait-fade { width: 205px; }
  }
  @media (max-width: 760px) {
    .following { margin-top: 44px; padding: 20px 12px 8px; }
    .following-heading { gap: 10px; margin-bottom: 15px; padding-bottom: 14px; }
    .following-heading h2 { gap: 8px; font-size: 22px; }
    .following-heading h2 > span { font-size: 27px; }
    .following-heading p { font-size: 10px; letter-spacing: 0; }
    .following-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; }
    .portrait-stage { height: clamp(130px, 43vw, 194px); }
    .portrait-fade { width: 144px; max-width: 84%; }
    [data-person="theshy"] .portrait-fade { margin-bottom: 17px; }
    [data-person="alcaraz"] .portrait-fade { width: 144px; }
    [data-person="sinner"] .portrait-fade { width: 180px; margin-bottom: 19px; }
    figcaption { padding-top: 8px; }
    .person-line h3 { font-size: 16px; }
    .person-caption { gap: 4px; letter-spacing: 0; font-size: 8px; padding-top: 7px; }
  }
</style>
