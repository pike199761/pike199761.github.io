---
const year = new Date().getFullYear();
---
<footer class="site-footer shell">
  <p>© {year} PIKE</p>
  <nav aria-label="其他链接"><a href="https://github.com/pike199761">GitHub <span aria-hidden="true">↗</span></a><a href="/rss.xml" aria-label="通过 RSS 订阅文章">RSS <span aria-hidden="true">↗</span></a></nav>
</footer>
<style>
  .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 72px; padding-block: 22px; border-top: 1px solid var(--line); color: var(--muted); }
  p { margin: 0; font-size: 11px; letter-spacing: .03em; }
  nav { display: flex; align-items: center; gap: 24px; }
  nav a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 12px; text-decoration: none; }
  nav a:hover { color: var(--ink); }
  nav span { font-size: 11px; }
  @media (max-width: 600px) { .site-footer { margin-top: 48px; padding-block: 18px; } }
</style>
