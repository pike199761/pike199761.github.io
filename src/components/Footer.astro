---
const year = new Date().getFullYear();
---
<footer>
  <div class="shell footer-grid">
    <div class="identity"><strong>PIKE<i>.</i></strong><p>把喜欢的人和事，写得久一点。</p></div>
    <span class="edition">001 / {year}</span>
    <div class="right"><a href="https://github.com/pike199761">GitHub</a><a href="/rss.xml">RSS</a></div>
  </div>
</footer>
<style>
  footer { margin-top: clamp(6rem, 11vw, 10rem); padding: 2.4rem 0 3rem; border-top: 1px solid var(--line); color: var(--ink); }
  .footer-grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 2rem; }
  strong { font-size: 1.15rem; letter-spacing: -.04em; }
  strong i { color: var(--orange); font-style: normal; }
  p { margin: .25rem 0 0; color: var(--muted); font-size: .7rem; }
  .edition { color: var(--muted); font-size: .52rem; font-weight: 700; letter-spacing: .16em; }
  .right { display: flex; justify-content: flex-end; gap: 1.2rem; }
  a { color: var(--muted); font-size: .68rem; font-weight: 700; text-decoration: none; }
  a:hover { color: var(--orange-dark); }
  @media (max-width: 650px) {
    footer { margin-top: 5rem; }
    .footer-grid { grid-template-columns: 1fr auto; }
    .edition { display: none; }
  }
</style>
