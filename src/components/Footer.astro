---
const year = new Date().getFullYear();
---
<footer class="site-footer shell">
  <div class="footer-sign"><a href="/" aria-label="PIKE 首页">pike<span>.</span></a><p>有想写的，就放在这里。</p></div>
  <div class="footer-meta"><p>© {year} PIKE</p><nav aria-label="其他链接"><a href="https://github.com/pike199761">GitHub <span aria-hidden="true">↗</span></a><a href="/rss.xml" aria-label="通过 RSS 订阅文章">RSS <span aria-hidden="true">↗</span></a></nav></div>
</footer>
<style>
  .site-footer { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-top: 88px; padding-block: 30px 36px; border-top: 1px solid var(--ink); color: var(--muted); }
  .footer-sign > a { color: var(--ink); font: 800 38px/.9 Arial, sans-serif; letter-spacing: -3px; text-decoration: none; }
  .footer-sign > a span { color: var(--orange); }
  p { margin: 12px 0 0; font-size: 11px; }
  .footer-meta { display: flex; align-items: center; gap: 40px; }
  .footer-meta p { font: 10px var(--mono); margin: 0; }
  nav { display: flex; align-items: center; gap: 24px; }
  nav a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 11px; text-decoration: none; }
  nav a:hover { color: var(--ink); }
  @media (max-width: 760px) { .site-footer { margin-top: 52px; padding-block: 26px; align-items: start; } .footer-meta { flex-direction: column; align-items: end; gap: 4px; } nav { gap: 18px; } .footer-meta p { margin-top: 4px; } .footer-sign p { max-width: 150px; } }
</style>
