---
import { SITE_TITLE } from '../consts';
const path = Astro.url.pathname;
const links = [{ href: '/', label: '首页' }, { href: '/blog/', label: '文章' }, { href: '/about/', label: '关于' }];
const active = (href: string) => href === '/' ? path === '/' : path === href.slice(0, -1) || path.startsWith(href);
---
<a class="skip-link" href="#main-content">跳到正文</a>
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label={SITE_TITLE + ' 首页'}>pike<span>.</span></a>
    <nav aria-label="主导航">{links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--paper); }
  .nav-wrap { min-height: 80px; display: flex; justify-content: space-between; align-items: center; gap: 24px; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: baseline; min-height: 44px; font-size: 27px; font-weight: 700; letter-spacing: -1.2px; text-decoration: none; }
  .brand > span { color: var(--orange); }
  nav { display: flex; gap: 32px; align-items: center; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; text-decoration: none; position: relative; }
  nav a[aria-current], nav a:hover { color: var(--ink); }
  nav a[aria-current]::after { content: ''; position: absolute; bottom: 2px; left: 0; right: 0; height: 3px; border-radius: 3px; background: var(--orange); }
  .skip-link { position: fixed; top: -100px; left: 16px; z-index: 50; padding: 10px 20px; background: var(--ink); color: white; }
  .skip-link:focus { top: 10px; }
  @media (max-width: 600px) { .nav-wrap { min-height: 68px; gap: 20px; } nav { gap: 26px; } .brand { font-size: 25px; } }
</style>
