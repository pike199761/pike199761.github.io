---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title="关于 — PIKE" description="关于 Pike 和这个个人博客。" /></head>
<body>
  <Header />
  <main id="main-content" tabindex="-1" class="shell about">
    <header class="page-heading"><div><p class="eyebrow">ABOUT / 关于这里</p><h1>你好，我是 Pike。</h1></div><p>一个人的兴趣存档</p></header>
    <div class="about-layout"><div class="about-mark" aria-hidden="true"><span class="mark-small">EST. 2026</span><span class="mark-letter">p.</span><span class="mark-bottom">A PERSONAL JOURNAL <span>↗</span></span></div><div>
    <div class="about-copy prose">
      <p>这里是我的个人博客。</p>
      <p>平时关注小米，也看库里、C罗、阿尔卡拉斯和 TheShy 的比赛。还会看看电影、读点书，折腾一些新东西。</p>
      <p>有想写的，就放在这里。</p>
      <a class="text-link" href="/blog/">看看文章 <span aria-hidden="true">→</span></a>
    </div>
    <section class="colophon" aria-labelledby="site-heading"><h2 id="site-heading">关于这个小站</h2><p>用 Astro 搭建，托管在 GitHub Pages。文章以 Markdown 文件保存。</p><a class="text-link" href="/rss.xml">通过 RSS 订阅 <span aria-hidden="true">↗</span></a></section>
    </div></div>
  </main>
  <Footer />
</body>
</html>
<style>
  .about-layout { display: grid; grid-template-columns: 330px minmax(0, 1fr); gap: 88px; align-items: start; margin-top: 45px; }
  .about-mark { display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4/4.6; padding: 24px; background: var(--orange); transform: rotate(-3deg); color: var(--ink); }
  .mark-small, .mark-bottom { font: 10px var(--mono); letter-spacing: .06em; }
  .mark-letter { align-self: center; font: 900 240px/.8 Arial, sans-serif; letter-spacing: -.09em; padding-bottom: 38px; padding-right: 20px; }
  .mark-bottom { display: flex; align-items: center; justify-content: space-between; }
  .mark-bottom > span { font-size: 24px; }
  .about-copy { max-width: 640px; padding-top: 9px; }
  .about-copy .text-link { margin-top: 0; }
  .colophon { max-width: 640px; margin-top: 35px; padding-top: 24px; border-top: 1px solid var(--line); }
  .colophon h2 { margin: 0 0 12px; font-size: 12px; font-weight: 500; }
  .colophon p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.95; }
  .colophon .text-link { margin-top: 8px; color: var(--muted); font-size: 11px; }
  @media (max-width: 1000px) { .about-layout { grid-template-columns: 260px minmax(0, 1fr); gap: 48px; } .mark-letter { font-size: 200px; } }
  @media (max-width: 760px) { .about-layout { display: flex; flex-direction: column; gap: 36px; margin-top: 36px; } .about-mark { width: 220px; padding: 18px; align-self: center; } .mark-letter { font-size: 170px; padding-bottom: 27px; } .mark-small, .mark-bottom { font-size: 8px; } .about-copy { padding-top: 0; } .colophon { margin-top: 24px; } }
</style>
