---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title="关于 — PIKE" description="关于 Pike 和这个个人博客。" /></head>
<body>
  <Header />
  <main id="main-content" tabindex="-1" class="shell about">
    <header class="page-heading"><h1>你好，我是 Pike。</h1></header>
    <div class="about-copy prose">
      <p>这里是我的个人博客。</p>
      <p>平时关注小米，也看库里、C罗、阿尔卡拉斯和 TheShy 的比赛。还会看看电影、读点书，折腾一些新东西。</p>
      <p>有想写的，就放在这里。</p>
      <a class="text-link" href="/blog/">看看文章 <span aria-hidden="true">→</span></a>
    </div>
    <section class="colophon" aria-labelledby="site-heading"><h2 id="site-heading">关于这个小站</h2><p>用 Astro 搭建，托管在 GitHub Pages。文章以 Markdown 文件保存。</p><a class="text-link" href="/rss.xml">通过 RSS 订阅 <span aria-hidden="true">↗</span></a></section>
  </main>
  <Footer />
</body>
</html>
<style>
  .about { max-width: 1040px; min-height: calc(100svh - 220px); }
  .page-heading { padding-bottom: 28px; }
  .about-copy { max-width: 650px; }
  .about-copy .text-link { margin-top: 2px; }
  .colophon { max-width: 650px; margin-top: 48px; padding: 24px 28px; border-left: 3px solid var(--orange); border-radius: 0 12px 12px 0; background: var(--card); }
  .colophon h2 { margin: 0 0 10px; font-size: 13px; font-weight: 500; }
  .colophon p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.9; }
  .colophon .text-link { margin-top: 4px; color: var(--muted); font-size: 12px; }
  @media (max-width: 600px) { .colophon { margin-top: 35px; } }
</style>
