---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { comparePosts, postUrl, readingMinutes } from '../../lib/posts';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(comparePosts);
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title="文章 — PIKE" description={SITE_DESCRIPTION} /></head>
<body><Header /><main id="main-content" tabindex="-1" class="shell archive">
  <header class="page-heading"><div><p class="eyebrow">THE INDEX / 文章归档</p><h1>写过的，都在这。</h1></div><p class="index-count"><strong>{String(posts.length).padStart(2, '0')}</strong> 篇文章</p></header>
  <div class="archive-layout">
  <div class="archive-tools" data-archive-tools hidden>
    <p class="filter-label eyebrow">找点感兴趣的</p>
    <div class="search-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label for="post-search" class="sr-only">搜索文章标题、简介或标签</label><input id="post-search" type="search" placeholder="搜索文章…" autocomplete="off" /></div>
    <div class="tag-filters" role="group" aria-label="按标签筛选"><button type="button" data-tag="" aria-pressed="true">全部 <span>{posts.length}</span></button>{tags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">{tag}<span>{posts.filter(post => post.data.tags.includes(tag)).length}</span></button>)}</div>
  </div>
  <div class="archive-results">
  <div class="list-heading"><span class="eyebrow">ALL ENTRIES</span><p id="result-count" role="status" aria-live="polite">共 {posts.length} 篇文章</p></div>
  <section class="post-list" aria-label="文章列表">
    {posts.map((post, index) => <a class="post-row" href={postUrl(post.id)} data-post data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ')} data-tags={JSON.stringify(post.data.tags)}>
      <div class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><div class="post-copy"><div class="post-meta"><FormattedDate date={post.data.pubDate} /><span>约 {readingMinutes(post.body)} 分钟</span></div><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span class="pill">{tag}</span>)}</div></div>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>)}
  </section>
  {posts.length === 0 && <p class="empty-archive">第一篇还在路上。过阵子再来看看。</p>}
  <div class="no-results" data-no-results hidden><h2>没有找到文章</h2><p>没有找到匹配的文章，换个词，或者看看全部。</p><button class="button" type="button" data-reset>清除筛选，查看全部</button></div>

  </div></div>
</main><Footer />
<script>
  const input = document.querySelector<HTMLInputElement>('#post-search');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-post]')].map(element => ({ element, text: (element.dataset.search ?? '').toLocaleLowerCase(), tags: JSON.parse(element.dataset.tags ?? '[]') as string[] }));
  const counter = document.querySelector('#result-count');
  const empty = document.querySelector<HTMLElement>('[data-no-results]');
  const controls = document.querySelector<HTMLElement>('[data-archive-tools]');
  let selectedTag = '';
  function applyFilters(updateUrl = true) {
    if (!input || !counter || !empty) return;
    const query = input.value.trim().toLocaleLowerCase();
    let count = 0;
    for (const entry of entries) {
      const matches = entry.text.includes(query) && (!selectedTag || entry.tags.includes(selectedTag));
      entry.element.hidden = !matches;
      if (matches) count++;
    }
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.tag === selectedTag));
    counter.textContent = query || selectedTag ? `找到 ${count} 篇文章，共 ${entries.length} 篇` : `共 ${entries.length} 篇文章`;
    empty.hidden = count > 0 || entries.length === 0;
    if (updateUrl) {
      const url = new URL(window.location.href);
      query ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
      selectedTag ? url.searchParams.set('tag', selectedTag) : url.searchParams.delete('tag');
      window.history.replaceState(null, '', url);
    }
  }
  function restoreFilters() {
    if (!input) return;
    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';
    const tag = params.get('tag') ?? '';
    selectedTag = buttons.some(button => button.dataset.tag === tag) ? tag : '';
    applyFilters(false);
  }
  if (input && controls) {
    controls.hidden = false;
    restoreFilters();
    input.addEventListener('input', () => applyFilters());
    buttons.forEach(button => button.addEventListener('click', () => { selectedTag = button.dataset.tag ?? ''; applyFilters(); }));
    document.querySelector('[data-reset]')?.addEventListener('click', () => { input.value = ''; selectedTag = ''; applyFilters(); input.focus(); });
    window.addEventListener('popstate', restoreFilters);
    window.addEventListener('pageshow', restoreFilters);
  }
</script>
</body></html>

<style>
  .index-count { display: flex; align-items: baseline; gap: 12px; }
  .index-count strong { font: 400 64px/1 var(--serif); color: var(--ink); }
  .archive-layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 65px; align-items: start; }
  .archive-tools { position: sticky; top: 112px; max-height: calc(100dvh - 136px); overflow-y: auto; scrollbar-width: thin; }
  .filter-label { margin: 0 0 15px; font-size: 11px; }
  .search-box { display: flex; align-items: center; gap: 10px; padding: 0 10px; min-height: 44px; border: 1px solid var(--line); background: transparent; color: var(--muted); }
  .search-box:focus-within { outline: 2px solid var(--orange-dark); outline-offset: 2px; }
  .search-box svg { flex: 0 0 auto; width: 15px; }
  .search-box input { width: 100%; min-width: 0; min-height: 44px; border: 0; background: transparent; color: var(--ink); font-size: 12px; outline: none; }
  .search-box input::placeholder { color: var(--muted); }
  .tag-filters { display: flex; flex-direction: column; margin-top: 20px; }
  .tag-filters button { display: flex; align-items: center; justify-content: space-between; position: relative; min-height: 44px; padding: 0 12px; background: none; border: 0; color: var(--muted); font-size: 12px; text-align: left; }
  .tag-filters button span { font: 10px var(--mono); }
  .tag-filters button[aria-pressed="true"] { background: var(--orange); color: var(--ink); }
  .tag-filters button:hover:not([aria-pressed="true"]) { background: var(--paper-2); color: var(--ink); }
  .archive-results { min-width: 0; }
  .archive-layout:not(:has(.archive-tools:not([hidden]))) { grid-template-columns: 1fr; }
  .list-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--ink); padding: 0 0 17px; }
  .list-heading p { margin: 0; color: var(--muted); font-size: 11px; }
  .list-heading .eyebrow { font-size: 10px; }
  .post-row { display: grid; grid-template-columns: 34px minmax(0, 1fr) 22px; align-items: start; gap: 20px; padding: 29px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .post-number { padding-top: 1px; color: var(--muted); font: 11px/1.8 var(--mono); }
  .post-meta { display: flex; flex-wrap: wrap; gap: 18px; color: var(--muted); font-size: 10px; }
  .post-copy h2 { margin: 10px 0 11px; font-family: var(--serif); font-size: 25px; font-weight: 600; line-height: 1.6; }
  .post-copy p { margin: 0; max-width: 680px; color: var(--muted); font-size: 13px; line-height: 1.95; }
  .tags { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 15px; }
  .tags .pill { font-size: 10px; }
  .tags .pill::before { content: '#'; margin-right: 4px; }
  .arrow { padding-top: 39px; font-size: 21px; transition: transform .2s ease; }
  .post-row:hover .arrow { transform: translate(3px, -3px); color: var(--orange-dark); }
  .post-row:hover h2 { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 1px; text-underline-offset: .25em; }
  .no-results { padding: 50px 0; }
  .no-results h2 { margin: 0 0 12px; font: 600 25px var(--serif); }
  .no-results p { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
  .empty-archive { padding: 24px 0; color: var(--muted); }
  @media (max-width: 1000px) { .archive-layout { grid-template-columns: 180px minmax(0, 1fr); gap: 36px; } .post-row { gap: 12px; grid-template-columns: 25px minmax(0, 1fr) 18px; } }
  @media (max-width: 760px) {
    .archive-layout { grid-template-columns: 1fr; gap: 26px; }
    .archive-tools { position: static; max-height: none; overflow: visible; }
    .filter-label { display: none; }
    .index-count strong { font-size: 36px; }
    .tag-filters { flex-direction: row; flex-wrap: wrap; margin-top: 14px; gap: 4px; }
    .tag-filters button { min-height: 44px; padding: 0 11px; gap: 8px; }
    .tag-filters button span { display: none; }
    .post-row { padding: 24px 0; gap: 9px; grid-template-columns: 22px minmax(0, 1fr) 16px; }
    .post-copy h2 { font-size: 23px; }
    .post-copy p { font-size: 12px; }
    .arrow { font-size: 18px; }
  }
</style>
