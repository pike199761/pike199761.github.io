---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { comparePosts, postUrl, readingMinutes } from '../../lib/posts';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(comparePosts);
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title="文章 — PIKE" description={SITE_DESCRIPTION} /></head>
<body><Header /><main id="main-content" tabindex="-1" class="shell archive">
  <header class="page-heading"><h1>文章</h1></header>
  <div class="archive-tools" data-archive-tools hidden>
    <div class="search-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label for="post-search" class="sr-only">搜索文章标题、简介或标签</label><input id="post-search" type="search" placeholder="搜一搜标题、简介或标签…" autocomplete="off" /></div>
    <div class="tag-filters" role="group" aria-label="按标签筛选"><button type="button" data-tag="" aria-pressed="true">全部 <span>{posts.length}</span></button>{tags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}</div>
  </div>
  <div class="list-heading"><p id="result-count" role="status" aria-live="polite">共 {posts.length} 篇文章</p></div>
  <section class="post-list" aria-label="文章列表">
    {posts.map(post => <a class="post-row" href={postUrl(post.id)} data-post data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ')} data-tags={JSON.stringify(post.data.tags)}>
      <div class="post-copy"><div class="post-meta"><FormattedDate date={post.data.pubDate} /><span>约 {readingMinutes(post.body)} 分钟</span></div><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span class="pill">{tag}</span>)}</div></div>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>)}
  </section>
  {posts.length === 0 && <p class="empty-archive">第一篇还在路上。过阵子再来看看。</p>}
  <div class="no-results" data-no-results hidden><h2>没有找到文章</h2><p>没有找到匹配的文章，换个词，或者看看全部。</p><button class="button" type="button" data-reset>清除筛选，查看全部</button></div>

</main><Footer />
<script>
  const input = document.querySelector<HTMLInputElement>('#post-search');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-post]')].map(element => ({ element, text: (element.dataset.search ?? '').toLocaleLowerCase(), tags: JSON.parse(element.dataset.tags ?? '[]') as string[] }));
  const counter = document.querySelector('#result-count');
  const empty = document.querySelector<HTMLElement>('[data-no-results]');
  const controls = document.querySelector<HTMLElement>('[data-archive-tools]');
  let selectedTag = '';
  function applyFilters(updateUrl = true) {
    if (!input || !counter || !empty) return;
    const query = input.value.trim().toLocaleLowerCase();
    let count = 0;
    for (const entry of entries) {
      const matches = entry.text.includes(query) && (!selectedTag || entry.tags.includes(selectedTag));
      entry.element.hidden = !matches;
      if (matches) count++;
    }
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.tag === selectedTag));
    counter.textContent = query || selectedTag ? `找到 ${count} 篇文章，共 ${entries.length} 篇` : `共 ${entries.length} 篇文章`;
    empty.hidden = count > 0 || entries.length === 0;
    if (updateUrl) {
      const url = new URL(window.location.href);
      query ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
      selectedTag ? url.searchParams.set('tag', selectedTag) : url.searchParams.delete('tag');
      window.history.replaceState(null, '', url);
    }
  }
  function restoreFilters() {
    if (!input) return;
    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';
    const tag = params.get('tag') ?? '';
    selectedTag = buttons.some(button => button.dataset.tag === tag) ? tag : '';
    applyFilters(false);
  }
  if (input && controls) {
    controls.hidden = false;
    restoreFilters();
    input.addEventListener('input', () => applyFilters());
    buttons.forEach(button => button.addEventListener('click', () => { selectedTag = button.dataset.tag ?? ''; applyFilters(); }));
    document.querySelector('[data-reset]')?.addEventListener('click', () => { input.value = ''; selectedTag = ''; applyFilters(); input.focus(); });
    window.addEventListener('popstate', restoreFilters);
    window.addEventListener('pageshow', restoreFilters);
  }
</script>
</body></html>

<style>
  .archive { max-width: 1040px; }
  .page-heading { padding-bottom: 20px; }
  .archive-tools { max-width: 760px; margin-bottom: 24px; }
  .search-box { display: flex; align-items: center; gap: 12px; max-width: 420px; padding: 0 14px; min-height: 48px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--muted); }
  .search-box:focus-within { outline: 2px solid var(--orange-dark); outline-offset: 2px; }
  .search-box svg { flex: 0 0 auto; }
  .search-box input { width: 100%; min-width: 0; min-height: 46px; border: 0; background: transparent; color: var(--ink); font-size: 14px; outline: none; }
  .search-box input::placeholder { color: var(--muted); }
  .tag-filters { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 16px; }
  .tag-filters button { position: relative; min-height: 44px; padding: 0 2px; background: none; border: 0; color: var(--muted); font-size: 13px; }
  .tag-filters button span { margin-left: 4px; font-size: 11px; }
  .tag-filters button[aria-pressed="true"] { color: var(--orange-dark); }
  .tag-filters button[aria-pressed="true"]::after { content: ''; position: absolute; height: 1px; bottom: 4px; left: 2px; right: 2px; background: currentColor; }
  .tag-filters button:hover { color: var(--ink); }
  .list-heading { border-bottom: 1px solid var(--line); padding: 4px 0 14px; }
  .list-heading p { margin: 0; color: var(--muted); font-size: 12px; }
  .post-row { display: grid; grid-template-columns: minmax(0, 1fr) 20px; align-items: center; gap: 24px; padding: 28px; margin-top: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); text-decoration: none; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 18px; color: var(--muted); font-size: 12px; }
  .post-copy h2 { margin: 12px 0 8px; font-size: 25px; font-weight: 500; line-height: 1.6; }
  .post-copy p { margin: 0; max-width: 680px; color: var(--muted); font-size: 14px; line-height: 1.9; }
  .tags { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 14px; }
  .tags .pill { padding: 0; border: 0; font-size: 11px; }
  .arrow { color: var(--orange-dark); transition: transform .2s ease; }
  .post-row:hover .arrow { transform: translate(3px, -3px); }
  .post-row:hover h2 { color: var(--orange-dark); }
  .no-results { padding: 50px 0; }
  .no-results h2 { margin: 0 0 12px; font-size: 22px; font-weight: 500; }
  .no-results p { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
  .empty-archive { padding: 24px 0; color: var(--muted); }
  @media (max-width: 600px) { .post-row { gap: 16px; padding: 22px; } .post-copy h2 { font-size: 22px; } .post-copy p { font-size: 13px; } }
</style>
