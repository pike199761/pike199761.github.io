---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_TAGLINE } from '../consts';
const posts = (await getCollection('blog')).filter(post => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;
const interests = [
  ['MI', '小米', '产品、设计，以及一家公司怎么长大'],
  ['30', '库里', '空间、手感和不讲道理的三分球'],
  ['CR7', 'C罗', '天赋之外，长期主义最具体的样子'],
  ['A', '阿尔卡拉斯', '年轻、爆发力，还有快乐网球'],
  ['TS', 'TheShy', '操作、锋利，以及赛场之外的故事'],
];
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title={SITE_TITLE + ' — 个人杂志'} description={SITE_DESCRIPTION} /></head>
<body><Header /><main>
  <section class="masthead shell">
    <div class="mast-meta"><span>PERSONAL MAGAZINE</span><span>SPORT · TECH · CULTURE</span></div>
    <h1>PIKE<span>.</span></h1>
    <div class="tagline"><p>{SITE_TAGLINE}</p><small>一本不定期出版、没有编辑部的个人杂志。</small></div>
  </section>

  {featured && (
    <section class="cover-story shell">
      <div class="poster">
        <span class="poster-top">VOL. 01<br />SEPTEMBER 2026</span>
        <strong>喜欢<br />不是<br />一种<br /><i>小事</i></strong>
        <span class="poster-bottom">KEEP CARING<br />KEEP WRITING</span>
      </div>
      <article>
        <div class="story-meta"><p class="eyebrow">Cover story / 最新文章</p><FormattedDate date={featured.data.pubDate} /></div>
        <a href={'/blog/' + featured.id + '/'}><h2>{featured.data.title}</h2></a>
        <p class="dek">{featured.data.description}</p>
        <div class="story-foot"><div>{featured.data.tags.map(tag => <span class="pill">{tag}</span>)}</div><a class="read" href={'/blog/' + featured.id + '/'}>阅读全文 <b>→</b></a></div>
      </article>
    </section>
  )}

  <section class="interests shell">
    <header><p class="eyebrow">Subjects / 会写到的人和事</p><h2>关注列表</h2><p>不是栏目，更像几条长期追踪的线索。</p></header>
    <div class="interest-list">
      {interests.map((item, index) => <div class="interest"><span>{item[0]}</span><div><b>{item[1]}</b><p>{item[2]}</p></div><i>{String(index + 1).padStart(2, '0')}</i></div>)}
    </div>
  </section>

  <section class="archive-preview shell">
    <div class="archive-head"><p class="eyebrow">Archive</p><h2>所有文章</h2><a class="arrow-link" href="/blog/">打开目录</a></div>
    <div class="archive-list">
      {posts.slice(0, 5).map((post, index) => <a href={'/blog/' + post.id + '/'}><span>{String(index + 1).padStart(2, '0')}</span><strong>{post.data.title}</strong><p>{post.data.description}</p><FormattedDate date={post.data.pubDate} /><b>↗</b></a>)}
    </div>
  </section>
</main><Footer /></body>
</html>
<style>
  .masthead { padding-top: 2.4rem; }
  .mast-meta { display: flex; justify-content: space-between; padding-bottom: .7rem; border-bottom: 1px solid var(--ink); font-size: .62rem; font-weight: 700; letter-spacing: .16em; }
  .masthead h1 { margin: -.04em 0 -.1em; font-size: clamp(7rem, 22vw, 17rem); line-height: .85; letter-spacing: -.09em; }
  .masthead h1 span { color: var(--orange); }
  .tagline { display: flex; justify-content: space-between; align-items: end; padding-block: 1rem; border-block: 2px solid var(--ink); }
  .tagline p { margin: 0; font-family: var(--serif); font-size: clamp(1.35rem, 3vw, 2.4rem); font-weight: 700; }
  .tagline small { max-width: 260px; color: var(--muted); font-size: .72rem; text-align: right; }
  .cover-story { display: grid; grid-template-columns: .75fr 1.45fr; min-height: 610px; margin-top: 3rem; border: 2px solid var(--ink); background: var(--paper-2); }
  .poster { position: relative; overflow: hidden; padding: 2rem; color: var(--ink); background: var(--orange); border-right: 2px solid var(--ink); }
  .poster::before { content: 'P'; position: absolute; right: -3rem; bottom: -8rem; color: color-mix(in srgb, var(--paper) 22%, transparent); font-size: 31rem; font-weight: 700; line-height: 1; transform: rotate(-8deg); }
  .poster-top, .poster-bottom { position: relative; z-index: 1; display: block; font-size: .62rem; font-weight: 700; line-height: 1.4; letter-spacing: .16em; }
  .poster strong { position: relative; z-index: 1; display: block; margin-top: 4rem; font-size: clamp(3.6rem, 7vw, 6.7rem); line-height: .83; letter-spacing: -.08em; }
  .poster strong i { color: var(--paper); font-style: normal; }
  .poster-bottom { position: absolute; bottom: 2rem; }
  .cover-story article { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 6vw, 5rem); }
  .story-meta { display: flex; justify-content: space-between; padding-bottom: 1rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .72rem; }
  .cover-story article > a { text-decoration: none; }
  .cover-story h2 { margin: 2rem 0 1rem; font-size: clamp(3.4rem, 8vw, 7.5rem); line-height: .88; letter-spacing: -.07em; }
  .cover-story article > a:hover h2 { color: var(--orange-dark); }
  .dek { max-width: 650px; color: var(--muted); font-family: var(--serif); font-size: 1.08rem; }
  .story-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; }
  .story-foot > div { display: flex; gap: .4rem; }
  .read { padding: .7rem 1rem; color: #fff; background: var(--ink); font-size: .78rem; font-weight: 700; text-decoration: none; }
  .read b { color: var(--orange); }
  .interests { display: grid; grid-template-columns: .7fr 1.3fr; gap: 5rem; padding-top: 8rem; }
  .interests header { position: sticky; top: 110px; align-self: start; }
  .interests header h2, .archive-head h2 { margin: .8rem 0; font-size: clamp(3rem, 6vw, 5.5rem); line-height: .9; letter-spacing: -.06em; }
  .interests header > p:last-child { max-width: 310px; color: var(--muted); font-family: var(--serif); }
  .interest-list { border-top: 2px solid var(--ink); }
  .interest { display: grid; grid-template-columns: 80px 1fr auto; align-items: center; gap: 1rem; min-height: 118px; border-bottom: 1px solid var(--ink); }
  .interest > span { display: grid; place-items: center; width: 58px; aspect-ratio: 1; color: #fff; background: var(--orange); border-radius: 50%; font-weight: 700; }
  .interest b { font-size: 1.55rem; }
  .interest p { margin: .2rem 0 0; color: var(--muted); font-family: var(--serif); font-size: .85rem; }
  .interest i { color: var(--muted); font-size: .68rem; font-style: normal; }
  .archive-preview { padding-top: 8rem; }
  .archive-head { display: grid; grid-template-columns: 1fr auto; align-items: end; padding-bottom: 1.5rem; border-bottom: 2px solid var(--ink); }
  .archive-head .eyebrow { grid-column: 1 / -1; }
  .archive-list a { display: grid; grid-template-columns: 50px 1fr 1.5fr 150px 24px; gap: 1.2rem; align-items: center; padding: 1.2rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .archive-list a:hover { background: var(--paper-2); }
  .archive-list span, .archive-list time, .archive-list a > b { color: var(--muted); font-size: .72rem; }
  .archive-list p { margin: 0; color: var(--muted); font-family: var(--serif); font-size: .83rem; }
  @media (max-width: 820px) { .masthead { padding-top: 1.5rem; } .masthead h1 { font-size: 28vw; } .tagline { align-items: flex-start; flex-direction: column; gap: .5rem; } .tagline small { text-align: left; } .cover-story { grid-template-columns: 1fr; } .poster { min-height: 440px; border-right: 0; border-bottom: 2px solid var(--ink); } .interests { grid-template-columns: 1fr; gap: 2rem; padding-top: 5rem; } .interests header { position: static; } .archive-list a { grid-template-columns: 36px 1fr auto; } .archive-list p, .archive-list time { display: none; } }
  @media (max-width: 560px) { .mast-meta span:last-child { display: none; } .cover-story { margin-top: 1.5rem; } .poster { min-height: 380px; } .poster strong { font-size: 4.4rem; } .cover-story h2 { font-size: 3.8rem; } .story-foot { align-items: flex-start; flex-direction: column; gap: 1.5rem; } .interest { grid-template-columns: 64px 1fr; } .interest i { display: none; } .archive-head { grid-template-columns: 1fr; } }
</style>
