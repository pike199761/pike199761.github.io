---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_TAGLINE } from '../consts';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured] = posts;
const latestDate = featured
  ? [featured.data.pubDate.getMonth() + 1, featured.data.pubDate.getDate(), featured.data.pubDate.getFullYear()]
      .map((part, index) => index < 2 ? String(part).padStart(2, '0') : String(part))
      .join('.')
  : '';
const interests = [
  ['小米', '产品、设计，以及一家公司怎么长大'],
  ['库里', '空间、手感和那些不讲道理的三分球'],
  ['C罗', '天赋之外，长期主义最具体的样子'],
  ['阿尔卡拉斯', '年轻、爆发力，还有快乐网球'],
  ['TheShy', '操作、锋利，以及赛场之外的故事'],
];
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title={SITE_TITLE + ' — 个人博客'} description={SITE_DESCRIPTION} /></head>
<body>
  <Header />
  <main>
    <section class="hero shell" data-hero>
      <div class="hero-copy">
        <p class="hero-kicker">PIKE / NOTES SINCE 2026</p>
        <h1>把喜欢的人和事，<br /><em>写得久一点。</em></h1>
        <p class="hero-note">电影、科技、比赛，还有一些没想明白的问题。先记下来，慢慢再说。</p>

        {featured && (
          <a class="latest" href={'/blog/' + featured.id + '/'}>
            <span class="latest-meta">LATEST · {latestDate}</span>
            <strong>{featured.data.title}</strong>
            <p>{featured.data.description}</p>
            <i aria-hidden="true">→</i>
          </a>
        )}
      </div>

      <figure class="hero-visual">
        <img src="/images/desk-light.svg" alt="深灰桌面上的半开杂志、暖白纸张、黑色玻璃、球体和一枚橙色书签，被下午的侧光照亮" />
        <figcaption>桌面上的一束光</figcaption>
        <span class="issue" aria-hidden="true">001</span>
      </figure>
    </section>

    <section class="subjects shell">
      <header class="section-head">
        <div>
          <p class="eyebrow">Subjects</p>
          <h2>会反复写到的</h2>
        </div>
        <p>不是栏目，也不需要凑齐更新。只是这些人和东西，我大概还会继续看很久。</p>
      </header>
      <div class="subject-list">
        {interests.map((item, index) => (
          <div class="subject-row">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{item[0]}</strong>
            <p>{item[1]}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="archive-preview shell">
      <header class="section-head archive-head">
        <div>
          <p class="eyebrow">Archive</p>
          <h2>最近写的</h2>
        </div>
        <a class="all-posts" href="/blog/">所有文章 <span>→</span></a>
      </header>
      <div class="archive-list">
        {posts.slice(0, 5).map((post, index) => (
          <a href={'/blog/' + post.id + '/'}>
            <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{post.data.title}</strong>
              <p>{post.data.description}</p>
            </div>
            <FormattedDate date={post.data.pubDate} />
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const hero = document.querySelector('[data-hero]');
    const visual = hero?.querySelector('.hero-visual');
    const allowMotion = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches;

    if (hero && visual && allowMotion) {
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width - 0.5) * 16;
        const y = ((event.clientY - rect.top) / rect.height - 0.5) * 16;
        visual.style.setProperty('--move-x', `${x.toFixed(2)}px`);
        visual.style.setProperty('--move-y', `${y.toFixed(2)}px`);
      });
      hero.addEventListener('pointerleave', () => {
        visual.style.setProperty('--move-x', '0px');
        visual.style.setProperty('--move-y', '0px');
      });
    }
  </script>
</body>
</html>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, .84fr) minmax(480px, 1.16fr);
    gap: clamp(2.5rem, 6vw, 6.5rem);
    align-items: center;
    min-height: min(790px, calc(100vh - 71px));
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
  }
  .hero-copy { position: relative; z-index: 2; }
  .hero-kicker {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: .61rem;
    font-weight: 700;
    letter-spacing: .18em;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(3.3rem, 5.25vw, 5rem);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -.065em;
    text-wrap: balance;
    animation: title-in 1s .18s both cubic-bezier(.2,.75,.25,1);
  }
  .hero h1 em { color: var(--orange); font-style: normal; }
  .hero-note {
    max-width: 31rem;
    margin: 1.65rem 0 0;
    color: var(--muted);
    font-size: .92rem;
    line-height: 1.85;
  }
  .latest {
    position: relative;
    display: block;
    max-width: 32rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding: 1.35rem 3.1rem 1.35rem 0;
    border-block: 1px solid var(--line);
    text-decoration: none;
  }
  .latest-meta {
    display: block;
    margin-bottom: .72rem;
    color: var(--orange-dark);
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .16em;
  }
  .latest strong { display: block; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.25; letter-spacing: -.035em; }
  .latest p { margin: .45rem 0 0; color: var(--muted); font-size: .78rem; line-height: 1.65; }
  .latest i {
    position: absolute;
    right: .1rem;
    top: 50%;
    color: var(--orange);
    font-size: 1.35rem;
    font-style: normal;
    transform: translateY(-50%);
    transition: transform .25s ease;
  }
  .latest:hover i { transform: translate(5px, -50%); }

  .hero-visual {
    --move-x: 0px;
    --move-y: 0px;
    position: relative;
    width: 100%;
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 30px;
    background: var(--image-black);
    box-shadow: 0 32px 80px rgba(24, 20, 16, .16);
    transform: translate(var(--move-x), var(--move-y));
    transition: transform .5s cubic-bezier(.2,.75,.25,1), box-shadow .4s ease;
    animation: image-in 1.4s both cubic-bezier(.2,.75,.25,1);
  }
  .hero-visual img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: inherit;
    pointer-events: none;
  }
  .hero-visual figcaption {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    margin: 0;
    color: rgba(255,255,255,.5);
    font-size: .55rem;
    letter-spacing: .16em;
  }
  .hero-visual .issue {
    position: absolute;
    right: 1.25rem;
    bottom: .9rem;
    color: rgba(255,255,255,.34);
    font-size: .6rem;
    letter-spacing: .16em;
  }

  .subjects, .archive-preview { padding-top: clamp(6rem, 11vw, 10rem); }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 430px);
    gap: 3rem;
    align-items: end;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--ink);
  }
  .section-head h2 { margin: .65rem 0 0; font-size: clamp(2.6rem, 5vw, 4.6rem); font-weight: 560; line-height: 1; letter-spacing: -.06em; }
  .section-head > p { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.8; }
  .subject-list { border-bottom: 1px solid var(--ink); }
  .subject-row {
    display: grid;
    grid-template-columns: 64px minmax(150px, .55fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    min-height: 92px;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }
  .subject-row:last-child { border-bottom: 0; }
  .subject-row > span { color: var(--muted); font-size: .6rem; letter-spacing: .12em; }
  .subject-row strong { font-size: 1.35rem; font-weight: 560; letter-spacing: -.03em; }
  .subject-row p { margin: 0; color: var(--muted); font-size: .82rem; }

  .archive-head { grid-template-columns: 1fr auto; }
  .all-posts { padding-bottom: .35rem; font-size: .72rem; font-weight: 700; text-decoration: none; }
  .all-posts span { display: inline-block; margin-left: .25rem; color: var(--orange); transition: transform .25s ease; }
  .all-posts:hover span { transform: translateX(5px); }
  .archive-list { border-bottom: 1px solid var(--ink); }
  .archive-list a {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 145px 24px;
    gap: 1.5rem;
    align-items: center;
    min-height: 130px;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .archive-list a:last-child { border-bottom: 0; }
  .archive-list .post-number, .archive-list :global(time) { color: var(--muted); font-size: .65rem; }
  .archive-list strong { font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 560; line-height: 1.2; letter-spacing: -.045em; }
  .archive-list p { margin: .35rem 0 0; color: var(--muted); font-size: .78rem; }
  .archive-list :global(time) { text-align: right; }
  .archive-list b { color: var(--orange); font-size: 1.1rem; transition: transform .25s ease; }
  .archive-list a:hover b { transform: translateX(5px); }

  @keyframes image-in { from { opacity: .85; transform: scale(1.015); } to { opacity: 1; transform: scale(1); } }
  @keyframes title-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; min-height: auto; gap: 3.5rem; padding-block: 4.5rem 6rem; }
    .hero-copy { max-width: 680px; }
    .latest { margin-top: 3.5rem; }
    .hero-visual { max-width: 820px; }
  }
  @media (max-width: 680px) {
    .hero { gap: 2.8rem; padding-block: 3.2rem 4.5rem; }
    .hero-kicker { margin-bottom: 1.4rem; }
    .hero h1 { font-size: clamp(2.65rem, 12vw, 3.45rem); line-height: 1.08; }
    .hero-note { margin-top: 1.25rem; font-size: .86rem; }
    .latest { margin-top: 2.8rem; }
    .hero-visual { aspect-ratio: 4 / 5; border-radius: 22px; }
    .hero-visual img { object-position: 69% center; }
    .section-head { grid-template-columns: 1fr; gap: 1.4rem; }
    .section-head > p { max-width: 32rem; }
    .subject-row { grid-template-columns: 34px 1fr; gap: .8rem; min-height: 88px; }
    .subject-row p { grid-column: 2; margin-top: -.3rem; }
    .archive-head { grid-template-columns: 1fr auto; gap: 1rem; }
    .archive-head .eyebrow { grid-column: auto; }
    .archive-list a { grid-template-columns: 34px minmax(0, 1fr) 22px; gap: .8rem; min-height: 112px; }
    .archive-list :global(time) { display: none; }
    .archive-list p { font-size: .74rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1, .hero-visual { animation: none; }
    .hero-visual, .latest i, .all-posts span, .archive-list b { transition: none; }
  }
</style>
