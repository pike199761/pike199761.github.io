---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { comparePosts, postUrl, readingMinutes } from '../lib/posts';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(comparePosts);
const [featured, ...rest] = posts;
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title={SITE_TITLE + ' — 个人博客'} description={SITE_DESCRIPTION} /></head>
<body>
  <Header />
  <main id="main-content" tabindex="-1" class="shell home">
    <header class="intro">
      <div class="intro-copy"><h1><span>把喜欢的人和事，</span><span>写得久一点<span class="period">。</span></span></h1></div>
      <div class="intro-art" aria-hidden="true"><span class="punctuation"></span></div>
    </header>

    <section class="latest" aria-labelledby="latest-heading">
      <div class="section-label"><span class="small-line" aria-hidden="true"></span><h2 id="latest-heading">最近写的</h2></div>
      <div class="entries">
        {featured ? <article class="featured">
          <div class="entry-meta"><FormattedDate date={featured.data.pubDate} /><span aria-hidden="true">·</span><span>约 {readingMinutes(featured.body)} 分钟</span></div>
          <h3><a class="entry-title" href={postUrl(featured.id)}>{featured.data.title}</a></h3>
          <p class="entry-description">{featured.data.description}</p>
          <a class="text-link read-link" href={postUrl(featured.id)} aria-label={'阅读全文：' + featured.data.title}>阅读全文 <span aria-hidden="true">→</span></a>
        </article> : <p class="empty-note">还没有文章。</p>}
        {rest.length > 0 && <div class="recent-list">{rest.slice(0, 3).map(post => <article><div class="recent-meta"><FormattedDate date={post.data.pubDate} /></div><h3><a href={postUrl(post.id)}>{post.data.title}<span aria-hidden="true">→</span></a></h3></article>)}</div>}
        <a class="text-link archive-link" href="/blog/">全部文章 <span class="article-count">{posts.length}</span><span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>
<style>
  .home { max-width: 1040px; min-height: calc(100svh - 240px); }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) 288px; align-items: center; gap: 40px; padding: 44px 0 48px; }
  .intro-copy { padding-block: 20px; }
  h1 { margin: 0; font-size: clamp(36px, 4.3vw, 54px); font-weight: 500; letter-spacing: -.055em; line-height: 1.55; }
  h1 > span { display: block; }
  .period { color: var(--orange-dark); }
  .intro-art { position: relative; height: 258px; overflow: hidden; isolation: isolate; border-radius: 32px 32px 8px 32px; background: var(--orange); }
  .intro-art::before, .intro-art::after { content: ''; position: absolute; width: 290px; height: 290px; border: 1px solid rgb(255 254 253 / 28%); border-radius: 50%; pointer-events: none; }
  .intro-art::before { top: -170px; left: -145px; }
  .intro-art::after { top: -145px; left: -170px; }
  .punctuation { position: absolute; right: 35px; bottom: 32px; width: 138px; height: 138px; border: 27px solid var(--card); border-radius: 50%; }
  .latest { display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 44px; padding: 32px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
  .section-label { display: flex; align-items: center; gap: 12px; align-self: start; min-height: 25px; }
  .section-label h2 { margin: 0; font-size: 13px; font-weight: 400; color: var(--muted); }
  .small-line { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); }
  .entry-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; color: var(--muted); font-size: 12px; line-height: 25px; }
  .featured h3 { margin: 14px 0 10px; font-size: clamp(23px, 2.6vw, 30px); font-weight: 500; letter-spacing: -.025em; line-height: 1.5; }
  .entry-title { text-decoration: none; transition: color .18s ease; }
  .entry-title:hover { color: var(--orange-dark); }
  .entry-description { max-width: 600px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.9; }
  .read-link { margin-top: 18px; gap: 18px; color: var(--orange-dark); }
  .read-link span { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: var(--orange-soft); font-size: 18px; }
  .archive-link { margin-top: 20px; gap: 10px; color: var(--muted); font-size: 12px; }
  .archive-link:hover { color: var(--ink); }
  .archive-link .article-count { color: var(--muted); font-size: 11px; transform: none; }
  .recent-list { margin-top: 28px; }
  .recent-list article { border-top: 1px solid var(--line); padding: 22px 0; }
  .recent-meta { color: var(--muted); font-size: 12px; }
  .recent-list h3 { margin: 8px 0 0; font-size: 19px; font-weight: 500; line-height: 1.7; }
  .recent-list a { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; text-decoration: none; }
  .recent-list a > span { color: var(--orange-dark); transition: transform .2s ease; }
  .recent-list a:hover > span { transform: translateX(4px); }
  .empty-note { margin: 0; color: var(--muted); font-size: 15px; }
  @media (max-width: 900px) {
    .intro { grid-template-columns: minmax(0, 1fr) 220px; gap: 28px; }
    .intro-art { height: 232px; }
    .punctuation { width: 116px; height: 116px; border-width: 23px; right: 24px; bottom: 28px; }
    .latest { grid-template-columns: 110px minmax(0, 1fr); gap: 28px; padding: 28px; }
  }
  @media (max-width: 680px) {
    .home { min-height: calc(100svh - 198px); }
    .intro { grid-template-columns: minmax(0, 1fr) 88px; gap: 16px; padding: 35px 0 30px; }
    .intro-copy { position: relative; z-index: 1; padding-block: 12px; }
    h1 { font-size: clamp(24px, 6.8vw, 42px); letter-spacing: -.055em; line-height: 1.65; }
    .intro-art { width: 88px; height: 100px; border-radius: 20px 20px 5px 20px; }
    .punctuation { width: 38px; height: 38px; border-width: 8px; right: 14px; bottom: 14px; }
    .intro-art::before, .intro-art::after { width: 130px; height: 130px; }
    .intro-art::before { top: -90px; left: -65px; }
    .intro-art::after { top: -78px; left: -77px; }
    .latest { grid-template-columns: 1fr; gap: 23px; padding: 24px; border-radius: 12px; }
    .featured h3 { margin-top: 12px; font-size: 23px; }
    .entry-description { font-size: 14px; }
    .archive-link { margin-top: 14px; }
  }
  @media (max-width: 360px) {
    .intro { grid-template-columns: minmax(0, 1fr) 64px; }
    .intro-art { width: 64px; height: 80px; border-radius: 16px 16px 4px 16px; }
    .punctuation { width: 30px; height: 30px; border-width: 6px; right: 9px; bottom: 16px; }
    .latest { padding: 20px; }
  }
</style>
